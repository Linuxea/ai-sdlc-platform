# ============================================================
# ai-sdlc-platform 环境变量模板
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略, 永不入库。
# 部署时由 docker-compose / K8s Secret 从环境注入。
# ============================================================

# --- 模型 API (M1) ---
# DeepSeek 平台 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-deepseek-key
# GLM fallback 槽位(可选, M4+ 启用)
ZHIPU_API_KEY=

# --- LiteLLM 网关 (M1) ---
# 网关自身的 master key(自生成随机串, 下游组件用它访问网关)
LITELLM_MASTER_KEY=sk-your-litellm-master-key
LITELLM_DB_URL=postgresql://litellm:litellm@localhost:5432/litellm

# --- n8n (M4) ---
N8N_ENCRYPTION_KEY=your-n8n-encryption-key
N8N_HOST=http://localhost:5678

# --- GitLab CE (M5/M7) ---
GITLAB_ROOT_PASSWORD=change-me
GITLAB_EXTERNAL_URL=http://gitlab.example.com

# --- OpenHands (M7) ---
OPENHANDS_LLM_API_KEY=   # 留空则走 LiteLLM 网关

# --- Langfuse (M7) ---
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
