      "name": "GitLab · 提交 release MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3000,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_API }}/api/v4/projects/{{ encodeURIComponent($('初始化上下文').item.json.repo) }}/repository/files/docs%2Fdeploy%2FRELEASE-draft.md",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"branch\": \"release/{{ $('初始化上下文').item.json.slug }}\", \"encoding\": \"utf-8\", \"content\": {{ JSON.stringify($json.output) }}, \"commit_message\": \"docs(release): {{ $('初始化上下文').item.json.slug }}\\n\\nAgent: release\\nIntent: {{ $('初始化上下文').item.json.slug }}\" }",
        "options": {}
      }
    },
    {
      "id": "n26",
      "name": "门禁D · 上线审批",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        3220,
        300
      ],
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "gate-d-{{ $('初始化上下文').item.json.slug }}"
        }
      }
    },
    {
