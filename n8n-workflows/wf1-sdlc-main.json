{
  "id": "f0cd4d4d-8933-4bcd-b8d6-809eeede5885",
  "name": "wf1-sdlc-main",
  "nodes": [
    {
      "id": "n01",
      "name": "需求提交表单",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 1.1,
      "position": [
        -1400,
        300
      ],
      "parameters": {
        "formTitle": "AI 流水线 · 需求提交",
        "formDescription": "提交想法，BA agent 将生成意图文档并进入门禁A审批",
        "formFields": {
          "values": [
            {
              "fieldLabel": "一句话概述",
              "requiredField": true
            },
            {
              "fieldLabel": "背景与动机",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "期望用户与场景",
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "约束(合规/预算/期限)",
              "fieldType": "textarea"
            }
          ]
        }
      }
    },
    {
      "id": "n02",
      "name": "初始化上下文",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1180,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "repo",
              "type": "string",
              "value": "={{ $env.TARGET_REPO }}"
            },
            {
              "id": "a2",
              "name": "slug",
              "type": "string",
              "value": "={{ $('需求提交表单').item.json['一句话概述'].slice(0,20).replace(/[^a-zA-Z0-9\\u4e00-\\u9fa5]+/g,'-') }}-{{ $now.format('MMdd-HHmm') }}"
            },
            {
              "id": "a3",
              "name": "runId",
              "type": "string",
              "value": "={{ $execution.id }}"
            },
            {
              "id": "a4",
              "name": "gateRoundA",
              "type": "number",
              "value": 0
            },
            {
              "id": "a5",
              "name": "intentForm",
              "type": "object",
              "value": "={{ $('需求提交表单').item.json }}"
            }
          ]
        }
      }
    },
    {
      "id": "n03",
      "name": "BA · 意图文档",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -960,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=表单输入:\n{{ JSON.stringify($json.intentForm, null, 2) }}\n\n按角色规范生成 intent.md 全文(markdown, 含澄清问题≤5条)。仅输出文档正文。",
        "options": {
          "systemMessage": "你是业务分析师(BA)。完整角色定义见平台仓库 agents/ba.md，以下为核心约束摘要：\n- 产出 intent.md: 背景动机/目标用户/想要什么(用户语言)/明确不做什么/约束/可验证成功判据/澄清问题(≤5条,每条附默认假设)\n- 成功判据必须可验证；禁止出现技术选型\n- 版本类事实必须附来源URL+日期, 超90天标[待复核]\n- 打回修订: 只改批注部分, 标记 <!-- revised:N -->"
        }
      }
    },
    {
      "id": "n04",
      "name": "DeepSeek Flash 模型",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -960,
        520
      ],
      "parameters": {
        "model": "deepseek-flash",
        "options": {
          "baseURL": "={{ $env.LITELLM_BASE_URL }}"
        }
      }
    },
    {
      "id": "n05",
      "name": "GitLab · 提交 intent MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -740,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_API }}/api/v4/projects/{{ encodeURIComponent($json.repo) }}/repository/files/docs%2Fintent%2FINTENT-{{ $json.slug }}.md",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"branch\": \"intent/{{ $json.slug }}\", \"encoding\": \"utf-8\", \"content\": {{ JSON.stringify($json.output) }}, \"commit_message\": \"docs(intent): {{ $json.slug }}\\n\\nAgent: ba\\nIntent: {{ $json.slug }}\" }",
        "options": {}
      },
      "notesInFlow": "需先经 create-branch API（见画布便签）"
    },
    {
      "id": "n06",
      "name": "门禁A · 需求审批",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -520,
        300
      ],
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "gate-a-{{ $json.slug }}"
        }
      }
    },
    {
      "id": "n07",
      "name": "A 通过?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -300,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n08",
      "name": "打回 BA (round+1)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -300,
        520
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "gateRoundA",
              "type": "number",
              "value": "={{ $('初始化上下文').item.json.gateRoundA + 1 }}"
            },
            {
              "id": "a2",
              "name": "rejectNote",
              "type": "string",
              "value": "={{ $json.body.comment || '评审未通过' }}"
            }
          ]
        }
      }
    },
    {
      "id": "n09",
      "name": "Architect · 规格与ADR",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        -80,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=已批准的意图({{ $json.slug }}): 见目标仓库 docs/intent/INTENT-{{ $json.slug }}.md\n\n按角色规范产出: 1) spec.md 全文 2) ADR(如有方案取舍) 3) openapi.yaml 片段(如涉接口)。以 <<<SPEC>>> 与 <<<ADR>>> 分隔输出。",
        "options": {
          "systemMessage": "你是软件架构师。完整角色定义见 agents/architect.md，核心约束摘要：\n- 规格含: 范围/模块设计/数据模型(含迁移与回滚)/接口契约/非功能需求/测试策略要点\n- 技术选型必须活体验证: 来源URL+验证日期(≤90天)+验证方式\n- 验收标准用 EARS 语法: 当<触发>时，系统<响应>\n- 与既有 ADR 冲突必须显式推翻并说明; 安全合规决策标[需人工确认]\n- 不写实现代码"
        }
      }
    },
    {
      "id": "n10",
      "name": "DeepSeek Pro-Max 模型",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -80,
        520
      ],
      "parameters": {
        "model": "deepseek-v4-pro-max",
        "options": {
          "baseURL": "={{ $env.LITELLM_BASE_URL }}"
        }
      }
    },
    {
      "id": "n11",
      "name": "GitLab · 提交 spec MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        140,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_API }}/api/v4/projects/{{ encodeURIComponent($('初始化上下文').item.json.repo) }}/repository/files/docs%2Fspec%2FSPEC-{{ $('初始化上下文').item.json.slug }}.md",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"branch\": \"spec/{{ $('初始化上下文').item.json.slug }}\", \"encoding\": \"utf-8\", \"content\": {{ JSON.stringify($json.output) }}, \"commit_message\": \"docs(spec): {{ $('初始化上下文').item.json.slug }}\\n\\nAgent: architect\\nIntent: {{ $('初始化上下文').item.json.slug }}\" }",
        "options": {}
      }
    },
    {
      "id": "n12",
      "name": "门禁B · 设计审批",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        360,
        300
      ],
      "parameters": {
        "resume": "webhook",
        "options": {
          "webhookSuffix": "gate-b-{{ $json.slug }}"
        }
      }
    },
    {
      "id": "n13",
      "name": "SM · 任务拆解",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        580,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=已批准的规格: docs/spec/SPEC-{{ $('初始化上下文').item.json.slug }}.md (目标仓库 {{ $('初始化上下文').item.json.repo }})\n\n按角色规范产出 TASKS-{{ $('初始化上下文').item.json.slug }}.md 全文。仅输出文档正文。",
        "options": {
          "systemMessage": "你是任务拆解专家(SM)。完整角色定义见 agents/sm.md，核心约束摘要：\n- INVEST 拆解, TDD 排序(先测试任务), 每任务对应≥1条 EARS 验收标准\n- 单任务禁止跨≥3模块; L规模(>1d)必须再拆\n- 验收禁止模糊词, 引用 EARS 编号; 依赖版本与 spec 活体验证结果一致"
        }
      }
    },
    {
      "id": "n14",
      "name": "GitLab · 提交 tasks MR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_API }}/api/v4/projects/{{ encodeURIComponent($('初始化上下文').item.json.repo) }}/repository/files/docs%2Ftasks%2FTASKS-{{ $('初始化上下文').item.json.slug }}.md",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"branch\": \"task/{{ $('初始化上下文').item.json.slug }}\", \"encoding\": \"utf-8\", \"content\": {{ JSON.stringify($json.output) }}, \"commit_message\": \"docs(tasks): {{ $('初始化上下文').item.json.slug }}\\n\\nAgent: sm\\nIntent: {{ $('初始化上下文').item.json.slug }}\" }",
        "options": {}
      }
    },
    {
      "id": "n15",
      "name": "OpenHands · 创建开发任务",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENHANDS_URL }}/api/conversations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Session-API-Key",
              "value": "={{ $env.OPENHANDS_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"initial_message\": { \"content\": [{ \"text\": \"你是开发 agent。任务清单: docs/tasks/TASKS-$('初始化上下文').item.json.slug.md (仓库 $('初始化上下文').item.json.repo)。步骤: 1) git clone http://root:{{ $env.GITLAB_TOKEN }}@10.0.0.5:8090/$('初始化上下文').item.json.repo.git 2) 逐任务 TDD 实现(先写测试) 3) lint+测试全绿 4) commit(带 Agent: dev trailer) push 到 task/$('初始化上下文').item.json.slug 分支。遵守 docs/constitution.md 全部铁律。\" }] }, \"workspace\": { \"kind\": \"LocalWorkspace\", \"working_dir\": \"workspace/dev\" }, \"agent\": { \"kind\": \"Agent\", \"llm\": { \"model\": \"openai/deepseek-v4-pro\", \"api_key\": \"{{ $env.LITELLM_MASTER_KEY }}\", \"base_url\": \"{{ $env.LITELLM_BASE_URL_INTERNAL }}\" }, \"tools\": [{ \"name\": \"terminal\", \"params\": {} }] } }",
        "options": {}
      },
      "notesInFlow": "实测契约(2026-09-24): X-Session-API-Key(容器 api-key.txt); llm 须内联 model=openai/<route>+base_url"
    },
    {
      "id": "n17",
      "name": "GitLab · 触发流水线",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_API }}/api/v4/projects/{{ encodeURIComponent($('初始化上下文').item.json.repo) }}/pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"ref\": \"task/{{ $('初始化上下文').item.json.slug }}\", \"variables\": { \"INTENT_SLUG\": \"{{ $('初始化上下文').item.json.slug }}\" } }",
        "options": {}
      }
    },
    {
      "id": "n18",
      "name": "CI 完成 · 全绿?",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "webhookId": "gitlab-pipeline-done",
      "parameters": {
        "httpMethod": "POST",
        "path": "gitlab-pipeline-done",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "n19",
      "name": "流水线结果?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.object_attributes.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n20",
      "name": "CI 失败 · 通知",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1900,
        520
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "message",
              "type": "string",
              "value": "=CI 失败({{ $json.body.object_attributes.status }}), 流水线 {{ $json.body.object_attributes.id }} — 人工介入或打回 OpenHands 重试"
            }
          ]
        }
      }
    },
    {
      "id": "n21",
      "name": "QA · 对抗性审查",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        2120,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=MR diff 与规格: 目标仓库 {{ $('初始化上下文').item.json.repo }} 分支 task/{{ $('初始化上下文').item.json.slug }}\n规格: docs/spec/SPEC-{{ $('初始化上下文').item.json.slug }}.md\n\n按角色规范输出 QA 报告(markdown): 判定 PASS|PASS_WITH_NITS|FAIL + 验收标准逐条核对 + 缺陷分级 + 补充测试。",
        "options": {
          "systemMessage": "你是对抗性质量工程师。完整角色定义见 agents/qa.md，核心约束摘要：\n- 优先级: 规格符合性(EARS逐条) > 边界异常 > 数据迁移回滚 > 安全 > 测试质量 > 可观测性\n- 有 BLOCKER 未解决=FAIL 无例外; 判定 FAIL 必须给可复现依据\n- 不确定的问题标[QA不确定]留给人工, 禁止装确定; 第三方库行为查官方文档(带URL+日期)\n- 只审 diff 与规格符合性, 不评'更优雅写法'"
        }
      }
    },
    {
      "id": "n22",
      "name": "GitLab · QA 报告评论",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2340,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GITLAB_API }}/api/v4/projects/{{ encodeURIComponent($('初始化上下文').item.json.repo) }}/merge_requests/~{{ $('初始化上下文').item.json.slug }}/notes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN",
              "value": "={{ $env.GITLAB_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"body\": {{ JSON.stringify($json.output) }} }",
        "options": {}
      },
      "notesInFlow": "MR IID 需从前面 GitLab API 响应透传（导入后修正表达式）"
    },
    {
      "id": "n23",
      "name": "门禁C · MR 合并回调",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        2560,
        300
      ],
      "webhookId": "gitlab-mr-merged",
      "parameters": {
        "httpMethod": "POST",
        "path": "gitlab-mr-merged",
        "responseMode": "onReceived"
      },
